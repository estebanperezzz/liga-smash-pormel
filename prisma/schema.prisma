generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Modelos de Autenticación (NextAuth / Auth.js v5) ──────────────────────────

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  role          String    @default("user")
  accounts      Account[]
  sessions      Session[]
  player        Player?
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime
  @@unique([identifier, token])
}

// ── Modelos del Juego ─────────────────────────────────────────────────────────

// Modelo de Temporadas
model Season {
  id        Int       @id @default(autoincrement())
  number    Int       @unique
  name      String?
  isActive  Boolean   @default(false)
  startDate DateTime  @default(now())
  endDate   DateTime?
  createdAt DateTime  @default(now())

  weeks     Week[]
}


// Modelo de Personajes de Smash Bros
model Character {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  image             String?
  series            String?
  createdAt         DateTime           @default(now())
  
  // Relaciones
  weeklySelections    WeeklyCharacter[]
  matchResults        MatchResult[]
  oldCharacterChanges CharacterChange[] @relation("OldCharacters")
  newCharacterChanges CharacterChange[] @relation("NewCharacters")
}

// Modelo de Jugadores
model Player {
  id                Int                @id @default(autoincrement())
  name              String             @unique
  createdAt         DateTime           @default(now())
  userId            String?            @unique

  // Relaciones
  user              User?              @relation(fields: [userId], references: [id])
  weeklyCharacters  WeeklyCharacter[]
  matchResults      MatchResult[]
  weeklyWins        Week[]
  characterChanges  CharacterChange[]
  teamMemberships   TeamMember[]
}

// Modelo de Semanas
model Week {
  id                Int                @id @default(autoincrement())
  weekNumber        Int
  startDate         DateTime
  endDate           DateTime
  winnerId                Int?
  winnerTeamId            Int?
  isTeamWeek              Boolean            @default(false)
  blockPreviousWeekChars  Boolean            @default(true)
  championImage           String?
  seasonId                Int?
  createdAt               DateTime           @default(now())

  // Relaciones
  winner            Player?            @relation(fields: [winnerId], references: [id])
  winnerTeam        Team?              @relation("WeekWinnerTeam", fields: [winnerTeamId], references: [id])
  season            Season?            @relation(fields: [seasonId], references: [id])
  weeklyCharacters  WeeklyCharacter[]
  matches           Match[]
  characterChanges  CharacterChange[]
  teams             Team[]
  teamMembers       TeamMember[]

  @@unique([seasonId, weekNumber])
}

// Modelo de Selección de Personaje Semanal
model WeeklyCharacter {
  id                Int                @id @default(autoincrement())
  playerId          Int
  characterId       Int
  weekId            Int
  slot              Int                @default(1) // 1 o 2 (cada jugador tiene hasta 2 personajes por semana)
  hasChanged        Boolean            @default(false)
  createdAt         DateTime           @default(now())

  // Relaciones
  player            Player             @relation(fields: [playerId], references: [id])
  character         Character          @relation(fields: [characterId], references: [id])
  week              Week               @relation(fields: [weekId], references: [id])

  // Constraint: Un jugador solo puede tener un personaje por slot por semana
  @@unique([playerId, weekId, slot])
  // Constraint: Un jugador no puede tener el mismo personaje en ambos slots
  @@unique([playerId, characterId, weekId])
}

// Modelo de Cambios de Personaje (Historial)
model CharacterChange {
  id                Int                @id @default(autoincrement())
  playerId          Int
  weekId            Int
  slot              Int                @default(1) // Qué slot fue cambiado (1 o 2)
  oldCharacterId    Int
  newCharacterId    Int
  changedAt         DateTime           @default(now())
  reason            String             @default("bottom3_rule")

  // Relaciones
  player            Player             @relation(fields: [playerId], references: [id])
  week              Week               @relation(fields: [weekId], references: [id])
  oldCharacter      Character          @relation("OldCharacters", fields: [oldCharacterId], references: [id])
  newCharacter      Character          @relation("NewCharacters", fields: [newCharacterId], references: [id])

  // Solo un cambio por jugador por semana (independiente del slot)
  @@unique([playerId, weekId])
}

// Modelo de Partidas
model Match {
  id                Int                @id @default(autoincrement())
  weekId            Int
  playedAt          DateTime           @default(now())
  
  // Relaciones
  week              Week               @relation(fields: [weekId], references: [id])
  results           MatchResult[]
  teamResults       TeamMatchResult[]
}

// Modelo de Resultados de Partida (Jugador + Posición)
model MatchResult {
  id                Int                @id @default(autoincrement())
  matchId           Int
  playerId          Int
  position          Int
  points            Int
  characterId       Int?               // Personaje usado en esta partida específica

  // Relaciones
  match             Match              @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player            Player             @relation(fields: [playerId], references: [id])
  character         Character?         @relation(fields: [characterId], references: [id])
  
  // Constraint: Un jugador solo puede tener una posición por partida
  @@unique([matchId, playerId])
  // Constraint: Una posición solo puede ser ocupada por un jugador por partida
  @@unique([matchId, position])
}

// ── Modelos de Semana de Equipos ──────────────────────────────────────────────

// Modelo de Equipos (solo existen dentro de una semana de equipos)
model Team {
  id           Int              @id @default(autoincrement())
  name         String
  image        String?
  weekId       Int
  createdAt    DateTime         @default(now())

  // Relaciones
  week         Week             @relation(fields: [weekId], references: [id])
  members      TeamMember[]
  matchResults TeamMatchResult[]
  wonWeeks     Week[]           @relation("WeekWinnerTeam")
}

// Modelo de Miembros de Equipo (un jugador pertenece a un solo equipo por semana)
model TeamMember {
  id        Int    @id @default(autoincrement())
  teamId    Int
  playerId  Int
  weekId    Int

  // Relaciones
  team      Team   @relation(fields: [teamId], references: [id])
  player    Player @relation(fields: [playerId], references: [id])
  week      Week   @relation(fields: [weekId], references: [id])

  // Un jugador solo puede estar en un equipo por semana
  @@unique([playerId, weekId])
}

// Modelo de Resultados de Partida por Equipo
model TeamMatchResult {
  id        Int   @id @default(autoincrement())
  matchId   Int
  teamId    Int
  position  Int
  points    Int

  // Relaciones
  match     Match @relation(fields: [matchId], references: [id], onDelete: Cascade)
  team      Team  @relation(fields: [teamId], references: [id])

  // Un equipo solo puede tener un resultado por partida
  @@unique([matchId, teamId])
  // Una posición solo puede ser ocupada por un equipo por partida
  @@unique([matchId, position])
}